# Orange Pi R1 Plus LTS (RK3328) - seed .config for coolsnowwolf/lede
# 用法: 把本文件放到 lede 仓库根目录, 文件名必须是 .config,
# 再把同目录的 feeds.conf.default / diy-part1.sh / openwrt-ci.yml
# 一起放到 fork 的 lede 仓库里 (见下面说明), 然后跑 GitHub Actions.
# 跑 make defconfig (lede 的 workflow 里已经有这一步) 会自动展开成完整 .config.
# 注意: 这是 seed 配置, 不是展开后的完整 .config, 不要指望它有上千行.
#
# 机型确认: LTS 版. 网卡是 YT8531C (非 LTS 是 RTL8211E), 内存 LPDDR3,
# 所以 device 必须是 xunlong_orangepi-r1-plus-lts, 用错非 LTS 版 eth0 可能不通.

# --- Target: rockchip / armv8, RK3328 ---
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_rockchip_armv8_DEVICE_xunlong_orangepi-r1-plus-lts=y
# CONFIG_TARGET_rockchip_armv8_DEVICE_xunlong_orangepi-r1-plus is not set

# --- 镜像 / 文件系统 ---
# 根分区改成 1024MB: 4 个代理插件 + sing-box/xray/v2ray/naiveproxy/mihomo
# 几个 Go 内核每个 5-20MB, 512MB 太紧.
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 两个都开会同时产出 ext4 和 squashfs 两种 sysupgrade.img.gz,
# ext4 首次启动自动扩容, squashfs 出问题可恢复出厂, 建议都留着.
# 编出来的文件在 bin/targets/rockchip/armv8/ 下,
# 名字形如 openwrt-rockchip-armv8-xunlong_orangepi-r1-plus-lts-ext4-sysupgrade.img.gz,
# 用 balenaEtcher / Rufus 写到 TF 卡就能启动.

# --- LuCI 网页管理 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y

# --- 上网方式: DHCP / 静态 / PPPoE ---
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ipv6helper=y

# --- 常用工具 ---
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y

# --- R1 Plus LTS 说明, 不用另加 ---
# 板子没有 WiFi, 不用加 wpad / 无线驱动.
# 第二个网口是 USB 的 RTL8153, 驱动 kmod-usb-net-rtl8152 已由设备定义自带.
# 默认 LAN 是 eth1, WAN 是 eth0, 登录 192.168.1.1, 密码 password.

# --- 代理插件: 4 个都编进去, 但同一时间只能开 1 个 ---
# PassWall / HomeProxy / OpenClash / SSR-Plus 都会装自己的 nftables 规则
# 并接管 DNS, 同时开必定冲突. 编译时全装没问题, 用的时候只启用一个,
# 切换前先把另外几个 stop + disable.
# 另: OpenClash 的 Mihomo 内核不是编译进来的, 首次在 LuCI 里点下载内核,
# 需要联网; HomeProxy / PassWall / SSR-Plus 的内核是下面编译进来的.

# PassWall (源: passwall_luci feed, 见 feeds.conf.default 顶部)
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
# 注意: 新版 PassWall 没有 INCLUDE_V2ray 这一项, v2ray-core 见下面直接选.

# SSR-Plus (源: helloworld feed, lede 默认已开)
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Mihomo=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_GeoData=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client=y
# 注意: 新版 SSR-Plus 的 V2Ray 内核选择只有 None / Xray 两档, 没有 v2ray-core,
# v2ray-core 见下面直接选.

# OpenClash (源: openclash feed, 见 feeds.conf.default 末尾)
CONFIG_PACKAGE_luci-app-openclash=y

# HomeProxy (源: diy-part1.sh 克隆到 package/homeproxy, 不是 feed)
CONFIG_PACKAGE_luci-app-homeproxy=y

# --- 代理内核: 直接选, 不管哪个插件用都能找到 ---
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_naiveproxy=y
CONFIG_PACKAGE_v2ray-core=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_mihomo=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
CONFIG_PACKAGE_haproxy=y

# --- 其他可选插件, 需要哪个就把前面的 # 去掉 ---
# CONFIG_PACKAGE_luci-app-turboacc=y
# CONFIG_PACKAGE_luci-app-upnp=y
# CONFIG_PACKAGE_luci-app-ddns=y
# CONFIG_PACKAGE_luci-app-arpbind=y
# CONFIG_PACKAGE_luci-app-wol=y
# CONFIG_PACKAGE_luci-app-diskman=y
